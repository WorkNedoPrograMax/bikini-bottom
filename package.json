{
  "name": "bikini-bottom",
  "version": "0.1.0",
  "private": true,
  "description": "A cozy home for your work — a SpongeBob town that wraps Claude Code.",
  "main": "dist/main/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "npm run build && electron .",
    "smoke": "npm run build && BIKINI_SMOKE=1 electron .",
    "rebuild": "electron-rebuild -w node-pty",
    "postinstall": "electron-rebuild -w node-pty",
    "compare": "node scripts/compare-usage.mjs"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.207",
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/xterm": "^5.5.0",
    "node-pty": "^1.0.0"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.2.0",
    "@types/node": "^22.10.0",
    "electron": "43.1.0",
    "typescript": "^5.7.0"
  }
}
